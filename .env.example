# Clerk (M2)
# Create an application at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhook signing secret from Clerk Dashboard → Webhooks
CLERK_WEBHOOK_SECRET=

# Auth routes (must match app paths)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Post-auth handler checks onboarding status and routes accordingly
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth/after-sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/auth/after-sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# Supabase (M3)
# Create a project at https://supabase.com — enable pgvector extension
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — webhooks and server actions use service role (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (M6 — Campaign Brain; optional — app works without key)
OPENAI_API_KEY=
# Optional override (default: gpt-4o-mini)
OPENAI_MODEL=

# Sentry (optional — no-op when DSN is unset)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Campaign knowledge storage backend: supabase (default when configured) | local
CAMPAIGN_KNOWLEDGE_STORAGE=

# Integrations (optional — set INTEGRATIONS_DEMO_MODE=true for simulated OAuth)
INTEGRATIONS_DEMO_MODE=false
INTEGRATION_TOKEN_ENCRYPTION_KEY=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
HIGGSFIELD_CLIENT_ID=
HIGGSFIELD_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Production (Vercel): https://campaignos-sigma.vercel.app — see docs/deploy/production-checklist.md
