{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaignos-qa-findings",
  "title": "CampaignOS daily QA findings",
  "type": "object",
  "required": ["date", "baseUrl", "loopsCompleted", "summary", "findings"],
  "properties": {
    "date": {
      "type": "string",
      "description": "ISO date YYYY-MM-DD (UTC)"
    },
    "baseUrl": {
      "type": "string",
      "description": "Primary URL exercised (usually production)"
    },
    "agentRunUrl": {
      "type": "string",
      "description": "Cursor agent run URL if available"
    },
    "loopsCompleted": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "skip", "flaky"]
          },
          "detail": { "type": "string" },
          "httpStatus": { "type": "integer" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity",
          "area",
          "repro",
          "expected",
          "actual",
          "autofixCandidate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable slug within the day, e.g. smoke-dashboard-500"
          },
          "title": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "area": {
            "type": "string",
            "description": "Route or module, e.g. /dashboard, auth, brain"
          },
          "repro": { "type": "string" },
          "expected": { "type": "string" },
          "actual": { "type": "string" },
          "autofixCandidate": {
            "type": "boolean",
            "description": "True only if a small, high-confidence code fix seems likely"
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Screenshot paths, curl snippets, console errors"
          }
        }
      }
    }
  }
}
